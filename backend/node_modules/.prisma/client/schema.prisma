generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  githubId  Int      @unique
  login     String   @unique
  name      String?
  email     String?
  avatarUrl String?
  commits   Commit[]
  medals    Medal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id              String   @id @default(uuid())
  githubId        Int      @unique
  name            String
  fullName        String   @unique
  htmlUrl         String
  description     String?
  language        String?
  stargazersCount Int      @default(0)
  commits         Commit[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Commit {
  sha         String     @id
  message     String
  date        DateTime
  htmlUrl     String
  repoId      String
  repo        Repository @relation(fields: [repoId], references: [id])
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  authorName  String // Backup if user not linked
  authorEmail String // Backup if user not linked

  // Stats
  additions Int @default(0)
  deletions Int @default(0)

  createdAt DateTime @default(now())
}

model Medal {
  id          String   @id @default(uuid())
  name        String // e.g. "Coder of the Month", "Night Owl"
  description String?
  date        DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model CacheLog {
  id        String   @id @default(uuid())
  type      String // "daily", "weekly", "monthly", "all_time", "leaderboard"
  data      Json
  createdAt DateTime @default(now())
}
